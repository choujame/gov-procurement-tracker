# Base URL for the Taiwan government procurement data API this server queries.
# Defaults to the g0v community mirror of the Public Construction Commission
# (PCC) open data (pcc.g0v.ronny.tw), which re-publishes 招標公告 (tenders),
# 決標公告 (awards), vendor, and agency records from web.pcc.gov.tw.
# Point this at the official PCC endpoint instead if/when you have access to it.
PCC_API_BASE_URL=https://pcc.g0v.ronny.tw/api

# Optional request timeout in milliseconds.
PCC_API_TIMEOUT_MS=15000
