{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "taiwan-architect-kb-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "MCP_OBJECT", "class_name": "TaiwanArchitectKbMCP" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["TaiwanArchitectKbMCP"] }
  ],
  "kv_namespaces": [
    { "binding": "OAUTH_KV", "id": "REPLACE_WITH_YOUR_KV_NAMESPACE_ID" }
  ],
  "vars": {
    "GITHUB_CLIENT_ID": "REPLACE_WITH_YOUR_GITHUB_OAUTH_APP_CLIENT_ID"
  }
}
